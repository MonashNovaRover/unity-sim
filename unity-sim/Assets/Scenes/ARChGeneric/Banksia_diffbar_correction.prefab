    name=\"gz::sim::systems::DetachableJoint\">\n    <parent_link>left_leg</parent_link>\n   
    <child_model>Banksia</child_model>\n    <child_link>left_diffend_dummy</child_link>\n   
    <output_topic>close_loop_left</output_topic>\n  </plugin>\n  <plugin filename=\"libgz-sim-detachable-joint-system.so\"
    name=\"gz::sim::systems::DetachableJoint\">\n    <parent_link>right_leg</parent_link>\n   
