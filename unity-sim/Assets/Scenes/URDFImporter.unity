  PluginText: "<gazebo reference=\"bootie_link_optical\">\n  <sensor name=\"bootie\"
    type=\"rgbd_camera\">\n    <pose> 0 0 0 0 -1.5707963267948966 1.5707963267948966
    </pose>\n    <!-- Get camera facing correct way in optical frame -->\n    <!--
    <plugin name=\"gz::sim::systems::Sensors\" filename=\"gz-sim-sensors-system\">\n       
    <frame_name>bootie_link_optical</frame_name>\n      </plugin> -->\n    <gz_frame_id>bootie_link_optical</gz_frame_id>\n   
    <topic>bootie</topic>\n    <visualize>true</visualize>\n    <update_rate>30</update_rate>\n   
    <always_on>1</always_on>\n    <camera name=\"bootie\">\n      <horizontal_fov>1.4311699866353502</horizontal_fov>\n     
    <image>\n        <width>1280</width>\n        <height>900</height>\n      </image>\n     
    <clip>\n        <near>0.4</near>\n        <far>10.0</far>\n      </clip>\n   
    </camera>\n  </sensor>\n</gazebo>"
