  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"gps\">\n  <sensor name=\"gps_rover\" type=\"navsat\">\n   
    <topic>gps</topic>\n    <plugin filename=\"gz-sim-navsat-system\" name=\"gz::sim::systems::NavSat\"></plugin>\n   
    <gz_frame_id>gps</gz_frame_id>\n    <always_on>true</always_on>\n    <update_rate>30</update_rate>\n   
    <gps>\n      <position_sensing>\n        <horizontal>\n          <noise type=\"gaussian\">\n           
    <mean>0.0</mean>\n            <stddev>0.0</stddev>\n          </noise>\n       
    </horizontal>\n        <vertical>\n          <noise type=\"gaussian\">\n           
    <mean>0.0</mean>\n            <stddev>0.0</stddev>\n          </noise>\n       
    </vertical>\n      </position_sensing>\n      <velocity_sensing>\n        <horizontal>\n         
    <noise type=\"gaussian\">\n            <mean>0.0</mean>\n            <stddev>0.0</stddev>\n         
    </noise>\n        </horizontal>\n        <vertical>\n          <noise type=\"gaussian\">\n           
    <mean>0.0</mean>\n            <stddev>0.0</stddev>\n          </noise>\n       
    </vertical>\n      </velocity_sensing>\n    </gps>\n  </sensor>\n</gazebo>"
