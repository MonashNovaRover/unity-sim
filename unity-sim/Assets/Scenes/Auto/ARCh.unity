  PluginText: "<gazebo>\n  <plugin filename=\"gz-sim-joint-state-publisher-system\"
    name=\"gz::sim::systems::JointStatePublisher\">\n    <topic>joint_states</topic>\n   
    <joint_name>chassis_to_left_leg</joint_name>\n    <joint_name>flp</joint_name>\n   
    <joint_name>flw</joint_name>\n    <joint_name>blp</joint_name>\n    <joint_name>blw</joint_name>\n   
    <joint_name>chassis_to_right_leg</joint_name>\n    <joint_name>frp</joint_name>\n   
    <joint_name>frw</joint_name>\n    <joint_name>brp</joint_name>\n    <joint_name>brw</joint_name>\n   
    <joint_name>chassis_to_diffbar</joint_name>\n    <joint_name>tl_ball_x</joint_name>\n   
    <joint_name>tl_ball_y</joint_name>\n    <joint_name>tl_ball_z</joint_name>\n   
    <joint_name>tr_ball_x</joint_name>\n    <joint_name>tr_ball_y</joint_name>\n   
    <joint_name>tr_ball_z</joint_name>\n    <joint_name>bl_ball_x</joint_name>\n   
    <joint_name>bl_ball_y</joint_name>\n    <joint_name>bl_ball_z</joint_name>\n   
    <joint_name>br_ball_x</joint_name>\n    <joint_name>br_ball_y</joint_name>\n   
