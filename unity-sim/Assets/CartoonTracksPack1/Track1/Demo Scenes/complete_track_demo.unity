    </noise>\n        </horizontal>\n        <vertical>\n          <noise type=\"gaussian\">\n           
    <mean>0.0</mean>\n            <stddev>0.0</stddev>\n          </noise>\n       
    </vertical>\n      </velocity_sensing>\n    </gps>\n  </sensor>\n</gazebo>"
