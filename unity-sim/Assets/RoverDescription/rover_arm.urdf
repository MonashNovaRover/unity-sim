  <!-- Arm Cameras for Gazebo-->
  <!-- Based on Microsoft Lifecam HD-3000 specs -->
  <!-- https://dl2jx7zfbtwvr.cloudfront.net/specsheets/WEBC1010.pdf -->
  <gazebo reference="arm_end_top_optical">
    <sensor name="arm_end_top" type="camera">
      <!-- Note: plugin only needs to be loaded once, auto_mount also loads this plugin, so arm and auto_mount cannot both exist -->
      <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>
      <pose> 0 0 0 0 -1.5707963267948966 1.5707963267948966</pose>
      <!-- To compensate for gazebo frame to ros optical frame-->
      <gz_frame_id>arm_end_top</gz_frame_id>
      <optical_frame_id>arm_end_top</optical_frame_id>
      <topic>arm/top</topic>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <always_on>1</always_on>
      <camera name="arm_end_top">
        <!-- "68.5° diagonal field of view" using DFOV and below aspect ratio here: https://vrguy.blogspot.com/2013/04/converting-diagonal-field-of-view-and.html
             Note: HFOV must be in radians -->
        <horizontal_fov>1.0711561186803784</horizontal_fov>
        <image>
          <!-- "Motion Video: 1280 X 720 pixel resolution" is a 16:9 aspect ratio-->
          <width>1280</width>
          <height>720</height>
        </image>
        <clip>
          <near>0.001</near>
          <far>10</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="arm_end_periscope_optical">
    <sensor name="arm_end_periscope" type="camera">
      <pose> 0 0 0 0 -1.5707963267948966 1.5707963267948966</pose>
      <!-- To compensate for gazebo frame to ros optical frame-->
      <gz_frame_id>arm_end_periscope</gz_frame_id>
      <optical_frame_id>arm_end_periscope</optical_frame_id>
      <topic>arm/periscope</topic>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <always_on>1</always_on>
      <camera name="arm_end_periscope">
        <!-- "68.5° diagonal field of view" using DFOV and below aspect ratio here: https://vrguy.blogspot.com/2013/04/converting-diagonal-field-of-view-and.html
             Note: HFOV must be in radians -->
        <horizontal_fov>1.0711561186803784</horizontal_fov>
        <image>
          <!-- "Motion Video: 1280 X 720 pixel resolution" is a 16:9 aspect ratio-->
          <width>1280</width>
          <height>720</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>10</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="arm_end_side_optical">
