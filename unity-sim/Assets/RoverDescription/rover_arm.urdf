  <!-- Plugin to allow Closed Kinetic Chains for Rover 
         Defines a fixed joint between a dummy link with the inertia of the "diffend" (part of leg attached to the difflink) and the leg on each side
         See Onshape for more details.
    -->
  <gazebo>
    <plugin filename="libgz-sim-detachable-joint-system.so" name="gz::sim::systems::DetachableJoint">
      <parent_link>left_leg</parent_link>
      <child_model>Banksia</child_model>
      <child_link>left_diffend_dummy</child_link>
      <output_topic>close_loop_left</output_topic>
    </plugin>
    <plugin filename="libgz-sim-detachable-joint-system.so" name="gz::sim::systems::DetachableJoint">
      <parent_link>right_leg</parent_link>
      <child_model>Banksia</child_model>
      <child_link>right_diffend_dummy</child_link>
      <output_topic>close_loop_right</output_topic>
    </plugin>
  </gazebo>
