  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo>\n  <plugin filename=\"libgz-sim-detachable-joint-system.so\"
    name=\"gz::sim::systems::DetachableJoint\">\n    <parent_link>left_leg</parent_link>\n   
    <child_model>Banksia</child_model>\n    <child_link>left_diffend_dummy</child_link>\n   
    <output_topic>close_loop_left</output_topic>\n  </plugin>\n  <plugin filename=\"libgz-sim-detachable-joint-system.so\"
    name=\"gz::sim::systems::DetachableJoint\">\n    <parent_link>right_leg</parent_link>\n   
    <child_model>Banksia</child_model>\n    <child_link>right_diffend_dummy</child_link>\n   
    <output_topic>close_loop_right</output_topic>\n  </plugin>\n</gazebo>"
--- !u!114 &1100438400588522526
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1584876460162822131}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"oak_link_optical\">\n  <sensor name=\"oak\" type=\"rgbd_camera\">\n   
    <pose> 0 0 0 0 -1.5707963267948966 1.5707963267948966 </pose>\n    <!-- Get camera
    facing correct way in optical frame -->\n    <plugin filename=\"gz-sim-sensors-system\"
    name=\"gz::sim::systems::Sensors\" />\n    <gz_frame_id>oak_link_optical</gz_frame_id>\n   
    <topic>oak</topic>\n    <visualize>true</visualize>\n    <update_rate>30</update_rate>\n   
    <always_on>1</always_on>\n    <camera name=\"oak\">\n      <horizontal_fov>1.4311699866353502</horizontal_fov>\n     
    <image>\n        <width>1280</width>\n        <height>900</height>\n      </image>\n     
    <clip>\n        <near>0.4</near>\n        <far>10.0</far>\n      </clip>\n   
    </camera>\n  </sensor>\n</gazebo>"
--- !u!114 &9201637010424533406
