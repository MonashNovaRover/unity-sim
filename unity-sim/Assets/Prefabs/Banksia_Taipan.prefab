--- !u!114 &7263158846434620415
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5432174284391015889}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo>\n  <plugin filename=\"gz-sim-joint-state-publisher-system\"
    name=\"gz::sim::systems::JointStatePublisher\">\n    <topic>joint_states</topic>\n   
    <joint_name>blp</joint_name>\n    <joint_name>brp</joint_name>\n    <joint_name>flp</joint_name>\n   
    <joint_name>frp</joint_name>\n    <joint_name>blw</joint_name>\n    <joint_name>brw</joint_name>\n   
    <joint_name>flw</joint_name>\n    <joint_name>frw</joint_name>\n    <joint_name>r_leg</joint_name>\n   
    <joint_name>l_leg</joint_name>\n    <joint_name>diffbar_pivot</joint_name>\n   
    <joint_name>diffbar_slide</joint_name>\n    <joint_name>tl_ball_roll</joint_name>\n   
    <joint_name>tl_ball_pitch</joint_name>\n    <joint_name>tl_ball_yaw</joint_name>\n   
    <joint_name>tr_ball_roll</joint_name>\n    <joint_name>tr_ball_pitch</joint_name>\n   
    <joint_name>tr_ball_yaw</joint_name>\n    <joint_name>bl_ball_roll</joint_name>\n   
    <joint_name>bl_ball_pitch</joint_name>\n    <joint_name>bl_ball_yaw</joint_name>\n   
    <joint_name>br_ball_roll</joint_name>\n    <joint_name>br_ball_pitch</joint_name>\n   
    <joint_name>br_ball_yaw</joint_name>\n    <!-- Arm joints -->\n    <joint_name>j1</joint_name>\n   
    <joint_name>j2</joint_name>\n    <joint_name>j3</joint_name>\n    <joint_name>l1_p_lower</joint_name>\n   
    <joint_name>l1_p_upper</joint_name>\n    <joint_name>l1_l2_pivot</joint_name>\n   
    <joint_name>j4</joint_name>\n    <joint_name>j5</joint_name>\n    <joint_name>j6</joint_name>\n   
    <joint_name>lead_left</joint_name>\n    <joint_name>la_prismatic</joint_name>\n 
    </plugin>\n</gazebo>"
