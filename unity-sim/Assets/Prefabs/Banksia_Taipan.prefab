  PluginText: "<gazebo reference=\"arm_end_periscope_optical\">\n  <sensor name=\"arm_end_periscope\"
    type=\"camera\">\n    <pose> 0 0 0 0 -1.5707963267948966 1.5707963267948966</pose>\n   
    <!-- To compensate for gazebo frame to ros optical frame-->\n    <gz_frame_id>arm_end_periscope</gz_frame_id>\n   
    <optical_frame_id>arm_end_periscope</optical_frame_id>\n    <topic>arm/periscope</topic>\n   
    <visualize>true</visualize>\n    <update_rate>30</update_rate>\n    <always_on>1</always_on>\n   
    <camera name=\"arm_end_periscope\">\n      <!-- \"68.5\xB0 diagonal field of
    view\" using DFOV and below aspect ratio here: https://vrguy.blogspot.com/2013/04/converting-diagonal-field-of-view-and.html\n            
    Note: HFOV must be in radians -->\n      <horizontal_fov>1.0711561186803784</horizontal_fov>\n     
    <image>\n        <!-- \"Motion Video: 1280 X 720 pixel resolution\" is a 16:9
    aspect ratio-->\n        <width>1280</width>\n        <height>720</height>\n     
    </image>\n      <clip>\n        <near>0.05</near>\n        <far>10</far>\n     
    </clip>\n    </camera>\n  </sensor>\n</gazebo>"
