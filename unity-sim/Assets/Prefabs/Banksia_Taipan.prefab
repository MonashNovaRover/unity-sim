--- !u!114 &5287112588779153417
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5432174284391015889}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<ros2_control name=\"GazeboSimSystemArm\" type=\"system\">\n  <hardware>\n   
    <plugin>gz_ros2_control/GazeboSimSystem</plugin>\n  </hardware>\n  <joint name=\"j1\">\n   
    <command_interface name=\"velocity\">\n      <param name=\"max\">1</param>\n   
    </command_interface>\n    <command_interface name=\"position\"></command_interface>\n   
    <state_interface name=\"velocity\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n    <state_interface name=\"position\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n  </joint>\n  <joint name=\"j2\">\n    <command_interface
    name=\"velocity\">\n      <param name=\"max\">1</param>\n    </command_interface>\n   
    <command_interface name=\"position\"></command_interface>\n    <state_interface
    name=\"velocity\">\n      <param name=\"initial_value\">0.0</param>\n    </state_interface>\n   
    <state_interface name=\"position\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n  </joint>\n  <joint name=\"j3\">\n    <command_interface
    name=\"velocity\">\n      <param name=\"max\">1</param>\n    </command_interface>\n   
    <command_interface name=\"position\"></command_interface>\n    <state_interface
    name=\"velocity\">\n      <param name=\"initial_value\">0.0</param>\n    </state_interface>\n   
    <state_interface name=\"position\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n  </joint>\n  <joint name=\"j4\">\n    <command_interface
    name=\"velocity\">\n      <param name=\"max\">1</param>\n    </command_interface>\n   
    <command_interface name=\"position\"></command_interface>\n    <state_interface
    name=\"velocity\">\n      <param name=\"initial_value\">0.0</param>\n    </state_interface>\n   
    <state_interface name=\"position\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n  </joint>\n  <joint name=\"j5\">\n    <command_interface
    name=\"velocity\">\n      <param name=\"max\">1</param>\n    </command_interface>\n   
    <command_interface name=\"position\"></command_interface>\n    <state_interface
    name=\"velocity\">\n      <param name=\"initial_value\">0.0</param>\n    </state_interface>\n   
    <state_interface name=\"position\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n  </joint>\n  <joint name=\"j6\">\n    <command_interface
    name=\"velocity\">\n      <param name=\"max\">1</param>\n    </command_interface>\n   
    <command_interface name=\"position\"></command_interface>\n    <state_interface
    name=\"velocity\">\n      <param name=\"initial_value\">0.0</param>\n    </state_interface>\n   
    <state_interface name=\"position\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n  </joint>\n  <joint name=\"lead_left\">\n    <command_interface
    name=\"velocity\">\n      <param name=\"max\">1</param>\n    </command_interface>\n   
    <command_interface name=\"position\"></command_interface>\n    <state_interface
    name=\"velocity\">\n      <param name=\"initial_value\">0.0</param>\n    </state_interface>\n   
    <state_interface name=\"position\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n  </joint>\n  <joint name=\"la_prismatic\">\n    <command_interface
    name=\"velocity\">\n      <param name=\"max\">1</param>\n    </command_interface>\n   
    <command_interface name=\"position\"></command_interface>\n    <state_interface
    name=\"velocity\">\n      <param name=\"initial_value\">0.0</param>\n    </state_interface>\n   
    <state_interface name=\"position\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n  </joint>\n</ros2_control>"
