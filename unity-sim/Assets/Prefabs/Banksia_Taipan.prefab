--- !u!114 &3481879857196553323
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5432174284391015889}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"arm_end_top_optical\">\n  <sensor name=\"arm_end_top\"
    type=\"camera\">\n    <!-- Note: plugin only needs to be loaded once, auto_mount
    also loads this plugin, so arm and auto_mount cannot both exist -->\n    <plugin
    filename=\"gz-sim-sensors-system\" name=\"gz::sim::systems::Sensors\" />\n   
    <pose> 0 0 0 0 -1.5707963267948966 1.5707963267948966</pose>\n    <!-- To compensate
    for gazebo frame to ros optical frame-->\n    <gz_frame_id>arm_end_top</gz_frame_id>\n   
    <optical_frame_id>arm_end_top</optical_frame_id>\n    <topic>arm/top</topic>\n   
    <visualize>true</visualize>\n    <update_rate>30</update_rate>\n    <always_on>1</always_on>\n   
    <camera name=\"arm_end_top\">\n      <!-- \"68.5\xB0 diagonal field of view\"
    using DFOV and below aspect ratio here: https://vrguy.blogspot.com/2013/04/converting-diagonal-field-of-view-and.html\n            
    Note: HFOV must be in radians -->\n      <horizontal_fov>1.0711561186803784</horizontal_fov>\n     
    <image>\n        <!-- \"Motion Video: 1280 X 720 pixel resolution\" is a 16:9
    aspect ratio-->\n        <width>1280</width>\n        <height>720</height>\n     
    </image>\n      <clip>\n        <near>0.001</near>\n        <far>10</far>\n     
    </clip>\n    </camera>\n  </sensor>\n</gazebo>"
--- !u!114 &7542065327083136338
MonoBehaviour:
  m_ObjectHideFlags: 0
