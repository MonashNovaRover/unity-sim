  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo>\n  <plugin filename=\"libgz-sim-detachable-joint-system.so\"
    name=\"gz::sim::systems::DetachableJoint\">\n    <parent_link>left_leg</parent_link>\n   
    <child_model>Banksia</child_model>\n    <child_link>left_diffend_dummy</child_link>\n   
    <output_topic>close_loop_left</output_topic>\n  </plugin>\n  <plugin filename=\"libgz-sim-detachable-joint-system.so\"
    name=\"gz::sim::systems::DetachableJoint\">\n    <parent_link>right_leg</parent_link>\n   
    <child_model>Banksia</child_model>\n    <child_link>right_diffend_dummy</child_link>\n   
    <output_topic>close_loop_right</output_topic>\n  </plugin>\n</gazebo>"
--- !u!114 &7839040938696495959
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4252379854426428780}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"livox_frame\">\n  <sensor name=\"gpu_lidar\" type=\"gpu_lidar\">\n   
    <update_rate>10</update_rate>\n    <topic>livox/lidar/unity</topic>\n    <gz_frame_id>livox_frame</gz_frame_id>\n   
    <update_rate>10</update_rate>\n    <ray>\n      <scan>\n        <horizontal>\n         
    <samples>720</samples>\n          <!-- MID-360 0.5\xB0 resolution -->\n         
    <resolution>1</resolution>\n          <!-- MID-360 HFOV = 360\xB0 -->\n         
    <min_angle>-3.14156</min_angle>\n          <max_angle>3.14156</max_angle>\n       
    </horizontal>\n        <vertical>\n          <samples>40</samples>\n         
    <!-- MID-360 point cloud density -->\n          <resolution>1</resolution>\n         
    <!-- MID-360 VFOV = 59\xB0 -->\n          <min_angle>0</min_angle>\n         
    <max_angle>0.9774</max_angle>\n        </vertical>\n      </scan>\n      <range>\n       
    <min>0.01</min>\n        <!-- MID-360 min. detection range -->\n        <max>40.0</max>\n       
    <!-- MID-360 max. detection range -->\n        <resolution>0.01</resolution>\n     
    </range>\n    </ray>\n    <always_on>1</always_on>\n    <visualize>true</visualize>\n 
    </sensor>\n</gazebo>"
--- !u!114 &7294756354967236539
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4252379854426428780}
  m_Enabled: 1
