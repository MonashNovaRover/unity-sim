  PluginText: "<gazebo>\n  <plugin filename=\"gz-sim-joint-state-publisher-system\"
    name=\"gz::sim::systems::JointStatePublisher\">\n    <topic>joint_states</topic>\n   
    <joint_name>chassis_to_left_leg</joint_name>\n    <joint_name>flp</joint_name>\n   
    <joint_name>flw</joint_name>\n    <joint_name>blp</joint_name>\n    <joint_name>blw</joint_name>\n   
    <joint_name>chassis_to_right_leg</joint_name>\n    <joint_name>frp</joint_name>\n   
    <joint_name>frw</joint_name>\n    <joint_name>brp</joint_name>\n    <joint_name>brw</joint_name>\n   
    <joint_name>chassis_to_diffbar</joint_name>\n    <joint_name>tl_ball_x</joint_name>\n   
    <joint_name>tl_ball_y</joint_name>\n    <joint_name>tl_ball_z</joint_name>\n   
    <joint_name>tr_ball_x</joint_name>\n    <joint_name>tr_ball_y</joint_name>\n   
    <joint_name>tr_ball_z</joint_name>\n    <joint_name>bl_ball_x</joint_name>\n   
    <joint_name>bl_ball_y</joint_name>\n    <joint_name>bl_ball_z</joint_name>\n   
    <joint_name>br_ball_x</joint_name>\n    <joint_name>br_ball_y</joint_name>\n   
    <joint_name>br_ball_z</joint_name>\n  </plugin>\n</gazebo>"
--- !u!114 &2081647115109134151
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4499239857994982696}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<ros2_control name=\"GazeboSimSystem\" type=\"system\">\n  <hardware>\n   
    <plugin>gz_ros2_control/GazeboSimSystem</plugin>\n  </hardware>\n  <joint name=\"flw\">\n   
    <command_interface name=\"velocity\">\n      <param name=\"min\">-50</param>\n     
    <param name=\"max\">50</param>\n    </command_interface>\n    <state_interface
    name=\"velocity\">\n      <param name=\"initial_value\">0.0</param>\n    </state_interface>\n   
    <state_interface name=\"position\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n  </joint>\n  <joint name=\"blw\">\n    <command_interface
    name=\"velocity\">\n      <param name=\"min\">-50</param>\n      <param name=\"max\">50</param>\n   
    </command_interface>\n    <state_interface name=\"velocity\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n    <state_interface name=\"position\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n  </joint>\n  <joint name=\"frw\">\n    <command_interface
    name=\"velocity\">\n      <param name=\"min\">-50</param>\n      <param name=\"max\">50</param>\n   
    </command_interface>\n    <state_interface name=\"velocity\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n    <state_interface name=\"position\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n  </joint>\n  <joint name=\"brw\">\n    <command_interface
    name=\"velocity\">\n      <param name=\"min\">-50</param>\n      <param name=\"max\">50</param>\n   
    </command_interface>\n    <state_interface name=\"velocity\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n    <state_interface name=\"position\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n  </joint>\n  <joint name=\"flp\">\n    <command_interface
    name=\"position\">\n      <param name=\"min\">-3.141592653589793</param>\n     
    <param name=\"max\">3.141592653589793</param>\n    </command_interface>\n   
    <command_interface name=\"velocity\">\n      <param name=\"min\">-3.141592653589793</param>\n     
    <param name=\"max\">3.141592653589793</param>\n    </command_interface>\n   
    <state_interface name=\"velocity\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n    <state_interface name=\"position\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n  </joint>\n  <joint name=\"blp\">\n    <command_interface
    name=\"position\">\n      <param name=\"min\">-3.141592653589793</param>\n     
    <param name=\"max\">3.141592653589793</param>\n    </command_interface>\n   
    <command_interface name=\"velocity\">\n      <param name=\"min\">-3.141592653589793</param>\n     
    <param name=\"max\">3.141592653589793</param>\n    </command_interface>\n   
    <state_interface name=\"velocity\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n    <state_interface name=\"position\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n  </joint>\n  <joint name=\"frp\">\n    <command_interface
    name=\"position\">\n      <param name=\"min\">-3.141592653589793</param>\n     
    <param name=\"max\">3.141592653589793</param>\n    </command_interface>\n   
    <command_interface name=\"velocity\">\n      <param name=\"min\">-3.141592653589793</param>\n     
    <param name=\"max\">3.141592653589793</param>\n    </command_interface>\n   
    <state_interface name=\"velocity\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n    <state_interface name=\"position\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n  </joint>\n  <joint name=\"brp\">\n    <command_interface
    name=\"position\">\n      <param name=\"min\">-3.141592653589793</param>\n     
    <param name=\"max\">3.141592653589793</param>\n    </command_interface>\n   
    <command_interface name=\"velocity\">\n      <param name=\"min\">-3.141592653589793</param>\n     
    <param name=\"max\">3.141592653589793</param>\n    </command_interface>\n   
    <state_interface name=\"velocity\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n    <state_interface name=\"position\">\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n  </joint>\n</ros2_control>"
